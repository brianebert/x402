# Copy this file on the target host for each generated vhost:
#   cp /srv/x402/.vhost.env.example /srv/x402/.<vhost_name>.env
#   sudo /srv/x402/scripts/host-vhost-install.sh <vhost_name>
#
# Example:
#   cp /srv/x402/.vhost.env.example /srv/x402/.nobody.news.env
#   sudo /srv/x402/scripts/host-vhost-install.sh nobody.news
#
# Named vhost installs read /srv/x402/.env first, then overlay this file.
# Put shared asset, facilitator, and split-payment settings in /srv/x402/.env.

# Required identity for this vhost. X402_SITE_NAME controls the Apache config
# filenames, so it should normally match <vhost_name>.
X402_SITE_NAME=example
X402_SERVER_NAME=example.com
# X402_SERVER_ALIASES="www.example.com *.example.com"
# X402_ENABLE_WWW_ALIAS=1

# install rewrites/enables this vhost. disable keeps generated config files.
# delete disables and removes generated config files.
X402_VHOST_ACTION=install

# static creates an Apache document root and generated X402 routes.
# proxy creates a reverse-proxy vhost, optionally with dynamic payment intents.
X402_VHOST_MODE=proxy

# Optional TLS.
# X402_DOMAIN is required when X402_ENABLE_SSL=1.
X402_ENABLE_SSL=1
X402_DOMAIN=example.com
X402_SSL_CERT_FILE=/etc/letsencrypt/live/example.com/fullchain.pem
X402_SSL_KEY_FILE=/etc/letsencrypt/live/example.com/privkey.pem

# Reverse-proxy settings. Required when X402_VHOST_MODE=proxy.
X402_PROXY_TARGET=http://127.0.0.1:3000/
X402_PROXY_PRESERVE_HOST=1
X402_PROXY_HTTPS_ONLY=1
# X402_PROXY_EXCLUDE_PATHS="/staging /staging/"
# X402_PROXY_ERROR_DOCUMENT=/errors/as-404.php

# Optional Apache snippets inserted inside the generated <VirtualHost> blocks.
# Snippets should contain directives only, not <VirtualHost> wrappers.
# X402_VHOST_HTTP_SNIPPET_FILE=/srv/x402/vhosts/example-http.inc
# X402_VHOST_SSL_SNIPPET_FILE=/srv/x402/vhosts/example-ssl.inc

# Optional dynamic payment intents for proxy/store vhosts.
X402_ENABLE_DYNAMIC_INTENTS=1
# Server-owned settlement policy for dynamic intents.
# Defaults to facilitator; set to local only when the vhost should avoid /settle.
# X402_DYNAMIC_SETTLEMENT_MODE=facilitator
X402_CHALLENGE_ENDPOINT=/x402/challenge
X402_DYNAMIC_CHECKOUT_ENDPOINT=/api/store/checkout
# Prefer a source file or existing secret path over embedding the secret here.
# X402_INTENT_SECRET=replace-me
# X402_INTENT_SECRET_SOURCE_FILE=/root/example-intent.key
X402_INTENT_SECRET_PATH=/etc/apache2/x402-secrets/example-intent.key

# Static route settings. Required only when X402_VHOST_MODE=static.
# X402_DOCROOT=/var/www/example
# X402_ASSET=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# X402_PAY_TO=GEXAMPLERECIPIENTPUBLICKEY
# X402_AMOUNT=1000000
# X402_DESCRIPTION="Access to foo"
# X402_MIMETYPE=text/html
# X402_ROUTE_COUNT=1
# X402_ROUTE_1_PATH=/app/foo
# X402_ROUTE_1_AMOUNT=1000000
# X402_ROUTE_1_DESCRIPTION="Access to foo"
# X402_ROUTE_1_CONTENT_FILE=index.html
# X402_ROUTE_1_CONTENT_BODY="yoo hoo"
