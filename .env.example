# Copy this file to `.env` on the target host before running either:
#   sudo ./scripts/host-admin-install.sh
# or the split install phases:
#   sudo ./scripts/host-system-install.sh
#   sudo ./scripts/host-vhost-install.sh

# Required base settings
# Optional for plain HTTP by IPv4. Required if you enable TLS later.
# X402_DOMAIN=pay.example.com
X402_ASSET=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
X402_PAY_TO=GEXAMPLERECIPIENTPUBLICKEY
# Optional for the default OpenZeppelin testnet facilitator.
# If omitted, host-system-install.sh will generate one automatically.
# X402_FACILITATOR_API_KEY=replace-me

# Common optional settings
X402_SITE_NAME=x402
# Optional Apache ServerName override. If omitted, the installer uses:
# - X402_DOMAIN when set
# - otherwise the detected host IPv4 address
# X402_SERVER_NAME=127.0.0.1
X402_DOCROOT=/var/www/x402
X402_AMOUNT=1000000
X402_DESCRIPTION="Access to foo"
X402_MIMETYPE=text/html
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
X402_NETWORK=stellar:testnet
X402_TIMEOUT_SECONDS=30
X402_PREPAY_MULTIPLIER_MAX=100
X402_CREDIT_SCOPE=payer-route
X402_CREDIT_TTL_SECONDS=86400

# Optional: use a source file instead of embedding the facilitator key here
# X402_FACILITATOR_API_KEY_SOURCE_FILE=/root/facilitator.key

# Optional split settlement
# X402_ENABLE_SPLIT=1
# X402_STELLAR_SOURCE_ACCOUNT=benobody_x402_testnet
# X402_SPLITTER_CONTRACT=CEXAMPLECONTRACTID
# X402_OPERATOR_STAKEHOLDER_1_NAME=server_operator
# X402_OPERATOR_STAKEHOLDER_1_BPS=300
# X402_OPERATOR_STAKEHOLDER_1_DEST=GEXAMPLEOPERATOR
# X402_PUBLISHER_STAKEHOLDER_1_NAME=content_publisher
# X402_PUBLISHER_STAKEHOLDER_1_BPS=9700
# X402_PUBLISHER_STAKEHOLDER_1_DEST=GEXAMPLEPUBLISHER
#
# Optional: add more operator or publisher stakeholders.
# X402_OPERATOR_STAKEHOLDER_2_NAME=platform_reserve
# X402_OPERATOR_STAKEHOLDER_2_BPS=200
# X402_OPERATOR_STAKEHOLDER_2_DEST=GEXAMPLERESERVE
# X402_PUBLISHER_STAKEHOLDER_2_NAME=creator
# X402_PUBLISHER_STAKEHOLDER_2_BPS=500
# X402_PUBLISHER_STAKEHOLDER_2_DEST=GEXAMPLECREATOR
#
# Optional: route-specific publisher stakeholders override the default
# publisher list for one generated route. Route keys are APP_FOO, PRICE,
# PRICEX2, PRICEX10, and PRICEX100.
# X402_ROUTE_APP_FOO_STAKEHOLDER_1_NAME=app_publisher
# X402_ROUTE_APP_FOO_STAKEHOLDER_1_BPS=9700
# X402_ROUTE_APP_FOO_STAKEHOLDER_1_DEST=GEXAMPLEAPPPUBLISHER
# X402_STELLAR_RPC_URL=https://soroban-testnet.stellar.org:443
# X402_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Optional: define a custom generated route list. If X402_ROUTE_COUNT is set,
# each route from 1..N must provide PATH, AMOUNT, and DESCRIPTION.
# X402_ROUTE_COUNT=1
# X402_ROUTE_1_PATH=/app/foo
# X402_ROUTE_1_AMOUNT=1000000
# X402_ROUTE_1_DESCRIPTION="Access to foo"
# X402_ROUTE_1_CONTENT_FILE=index.html
# X402_ROUTE_1_CONTENT_BODY="yoo hoo"
# X402_ROUTE_1_STAKEHOLDER_1_NAME=route_publisher
# X402_ROUTE_1_STAKEHOLDER_1_BPS=9700
# X402_ROUTE_1_STAKEHOLDER_1_DEST=GEXAMPLEROUTEPUBLISHER

# Optional TLS
# X402_ENABLE_SSL=1
# X402_DOMAIN=pay.example.com
# X402_SSL_CERT_FILE=/etc/letsencrypt/live/pay.example.com/fullchain.pem
# X402_SSL_KEY_FILE=/etc/letsencrypt/live/pay.example.com/privkey.pem
